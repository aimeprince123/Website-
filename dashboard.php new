    <h1>Heartbeat Monitoring Dashboard</h1>

    <p class="note">
        Latest saved readings from the ESP32 and MAX30102 sensor.
        This page refreshes every 5 seconds.
    </p>

    <div class="summary">
        <div class="card">
            <h3>Latest Heart Rate</h3>
            <div class="value">
                <?= $latest
                    ? htmlspecialchars($latest["bpm"]) . " BPM"
                    : "No data" ?>
            </div>
        </div>

        <div class="card">
            <h3>Wi-Fi Status</h3>
            <div class="value" style="font-size:22px">
                <?= $latest
                    ? htmlspecialchars($latest["wifi_status"] ?? "Unknown")
                    : "Unknown" ?>
            </div>
        </div>

        <div class="card">
            <h3>Call Status</h3>
            <div class="value" style="font-size:22px">
                <?= $latest
                    ? htmlspecialchars($latest["call_status"] ?? "Unknown")
                    : "Unknown" ?>
            </div>
        </div>

        <div class="card">
            <h3>Call Number</h3>
            <div class="value" style="font-size:20px">
                <?= $latest && $latest["call_number"]
                    ? htmlspecialchars($latest["call_number"])
                    : "Not set" ?>
            </div>
        </div>
    </div>

    <div class="table-container">
        <h2>Heartbeat History</h2>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>BPM</th>
                    <th>IR Value</th>
                    <th>Wi-Fi Status</th>
                    <th>Call Status</th>
                    <th>Call Number</th>
                    <th>Date and Time</th>
                </tr>
            </thead>

            <tbody>
                <?php if (empty($readings)): ?>
                    <tr>
                        <td colspan="7">No heartbeat readings received yet.</td>
                    </tr>
                <?php else: ?>
                    <?php foreach ($readings as $row): ?>
                        <tr>
                            <td><?= (int) $row["id"] ?></td>
                            <td><?= htmlspecialchars($row["bpm"]) ?></td>
                            <td><?= htmlspecialchars(
                                (string) ($row["ir_value"] ?? "N/A")
                            ) ?></td>
                            <td><?= htmlspecialchars(
                                $row["wifi_status"] ?? "Unknown"
                            ) ?></td>
                            <td><?= htmlspecialchars(
                                $row["call_status"] ?? "Unknown"
                            ) ?></td>
                            <td><?= htmlspecialchars(
                                $row["call_number"] ?? "Not set"
                            ) ?></td>
                            <td><?= htmlspecialchars($row["created_at"]) ?></td>
                        </tr>
                    <?php endforeach; ?>
                <?php endif; ?>
            </tbody>
        </table>
