
<?php
require_once "db.php";

try {
    $stmt = $pdo->query(
        "SELECT id, bpm, ir_value, wifi_status,
                call_status, call_number, created_at
         FROM heartbeat_readings
         ORDER BY id DESC
         LIMIT 50"
    );

    $readings = $stmt->fetchAll();

} catch (PDOException $e) {
    error_log($e->getMessage());
    die("Unable to load heartbeat readings.");
}

$latest = $readings[0] ?? null;
?>
